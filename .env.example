# How the Clerk reaches the docket-court room:
#   mattermost  through the Mattermost channel that Switch bridges into the room (works on any local server)
#   switch      as a registered Switch agent over the agent protocol (needs a registration key)
TRANSPORT=mattermost

# --- TRANSPORT=mattermost ---------------------------------------------------
# Address, username and password from Switch Console: Home > Messaging apps >
# Mattermost menu > Sign-in details. The Clerk posts from this account with a
# "[Clerk]" prefix, because Switch agents only answer their owner.
MATTERMOST_URL=http://localhost:55942
MATTERMOST_USERNAME=user
MATTERMOST_PASSWORD=
MATTERMOST_CHANNEL=docket-court

# --- TRANSPORT=switch -------------------------------------------------------
SWITCH_BRIDGE_URL=http://localhost:55941
SWITCH_REGISTRATION_KEY=
CLERK_AGENT_ID=
CLERK_API_KEY=
ROOM_ID=

# --- GitHub -------------------------------------------------------------------
# A fine-grained token limited to the demo repo, with Pull requests (read/write)
# and Commit statuses (read/write)
GITHUB_REPO=suhrith13/docket-demo-shop
GITHUB_TOKEN=

# --- The court -------------------------------------------------------------------
PROSECUTOR_NAME=docket-prosecutor
DEFENSE_NAME=docket-defense
JUDGE_NAME=user
CLERK_NAME=docket-clerk
REPO_PATH=C:\Users\adavi\docket\docket-demo-shop
# Cases 1 and 2 were run by hand, so new cases start at 3
FIRST_CASE_NUMBER=3
POLL_SECONDS=20
